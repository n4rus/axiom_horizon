{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kai",
  "version": "0.1.0",
  "identifier": "tree.axiom.local",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,    "windows": [
      {
        "title": "Kai",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:* https://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "resources": ["../../axiom_mcp_server.py", "../../kai_bridge.py", "../../axiom_alien.py"],
    "category": "DeveloperTool",
    "shortDescription": "Private local-first AI agent stack",
    "longDescription": "Kai runs its engine, MCP server and Ollama models entirely on your machine. No cloud API, no subscription, no data leaves."
  }
}
