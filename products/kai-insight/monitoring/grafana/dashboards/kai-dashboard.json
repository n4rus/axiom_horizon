{
  "dashboard": {
    "id": null,
    "title": "Kai AGI System Dashboard",
    "tags": ["kai", "agi", "monitoring"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "System Health",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "kai_health_status",
            "legendFormat": "{{status}}"
          }
        ]
      },
      {
        "id": 2,
        "title": "VFE (Variational Free Energy)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "kai_vfe",
            "legendFormat": "VFE"
          }
        ]
      },
      {
        "id": 3,
        "title": "Ricci Curvature",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          {
            "expr": "kai_ricci",
            "legendFormat": "Ricci"
          }
        ]
      },
      {
        "id": 4,
        "title": "Inference Latency",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "rate(kai_inference_duration_seconds_sum[5m]) / rate(kai_inference_duration_seconds_count[5m])",
            "legendFormat": "Avg Latency"
          }
        ]
      },
      {
        "id": 5,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          {
            "expr": "rate(kai_requests_total[5m])",
            "legendFormat": "Requests/sec"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  }
}
