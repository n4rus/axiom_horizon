[Unit]
Description=Kai AGI daemon — nightly darwin evolution + bench (Phase A convergence)
After=network.target ollama.service

[Service]
Type=oneshot
WorkingDirectory=/home/l/Desktop/AxiomTree/axiom_horizon
Environment=OLLAMA_HOST=http://127.0.0.1:11434
# Continuous 24/7: wiki 50 + darwin replay/seed/evolve/self-play + bench. Archive populated via seed if empty. Stops at gen 20.
ExecStart=/bin/bash -c 'mkdir -p /tmp/opencode; gen=$(python3 -c "import json,pathlib; p=pathlib.Path(\".axiom_state/darwin_archive.json\"); print(json.loads(p.read_text()).get(\"generation\",0) if p.exists() else 0)" 2>/dev/null); gen=${gen:-0}; if [ "$gen" -ge 20 ]; then echo "=== 24/7 done: gen $gen >=20 ===" >> /tmp/opencode/kai_nightly.log; exit 0; fi; python3 /home/l/Desktop/AxiomTree/axiom_horizon/tools/kai_wiki_ingest.py --limit 50 >> /tmp/opencode/kai_wiki.log 2>&1; /usr/local/bin/kai darwin replay --path ".kai_chat_memory*.json" --max 64 >> /tmp/opencode/kai_nightly.log 2>&1; if [ "$(/usr/local/bin/kai darwin status 2>&1 | grep -o "population: [0-9]*" | grep -o "[0-9]*")" = "0" ]; then /usr/local/bin/kai darwin seed >> /tmp/opencode/kai_nightly.log 2>&1; fi; timeout 1800 /usr/local/bin/kai darwin self-play >> /tmp/opencode/kai_nightly.log 2>&1; /usr/local/bin/kai bench >> /tmp/opencode/kai_nightly.log 2>&1; echo "=== 24/7 $(date -Is) gen $gen done ===" >> /tmp/opencode/kai_nightly.log'
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
